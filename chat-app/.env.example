# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required once migrations/security_hardening.sql has been applied.
# Supabase Dashboard -> Project Settings -> API -> service_role. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: get a message in Slack or Discord when something breaks.
# Create an incoming webhook there and paste its URL. Without it, errors still go to the server logs.
ERROR_WEBHOOK_URL=

# SEO. Defaults to https://nullchat.tech; change it if the site moves to another domain.
NEXT_PUBLIC_SITE_URL=
# Optional: the token from Google Search Console ("HTML tag" verification method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
